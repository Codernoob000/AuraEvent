# ==============================================================================
# AuraEvent — Environment Variables Configuration Template
# Strictly complies with Rule 1 of the Security Constitution.
# Copy this file to .env and populate real credentials. Never commit .env to git.
# ==============================================================================

# Server Network Configuration
# Description: Port number on which the Express server listens.
# Where to obtain: Any unreserved port on your host (default: 3000).
PORT=3000

# Application Environment
# Description: Set to 'production' for live deployments, or 'development' locally.
# When in production, debug messages are silenced and security headers are enforced.
NODE_ENV=development

# CORS Allowed Origin (Rule 6)
# Description: Explicit whitelist of client domains permitted to make API requests.
# Wildcard '*' is strictly prohibited in production.
# Where to obtain: Your frontend application URL (e.g., https://your-app.run.app or http://localhost:3000).
ALLOWED_ORIGIN=http://localhost:3000

# Google Gemini Model Configuration (Rule 13)
# Description: Specific Google Gemini model identifier used for event planning.
# Default: gemini-3.8-flash (supports gemini-3.8-flash, gemini-3-flash-preview, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Google Gemini API Key (Rule 13 & Google Services)
# Description: Private API key for Google Gemini used for AI event planning.
# Where to obtain: Google AI Studio (https://aistudio.google.com/app/apikey) or Google Cloud Console.
# Security Note: This key is ONLY read on the backend server. It is NEVER exposed to the client.
GEMINI_API_KEY=

# Google OAuth Client ID (Public / Client Identifier)
# Description: OAuth 2.0 Web Client ID for Google Workspace and Google Calendar sync.
# Where to obtain: Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth Client ID.
# Security Note: Public client identifier; safe for client-side configuration.
GOOGLE_CLIENT_ID=

# Session / JWT Encryption Secret (Rule 4)
# Description: Strong random cryptographic secret used to sign session cookies and tokens.
# Must be at least 32 characters in length.
# Where to obtain: Generate via: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# AI Per-User Token Budget (Rule 13)
# Description: Maximum tokens allowed per session/user to prevent cost exhaustion attacks.
MAX_USER_TOKEN_BUDGET=10000

