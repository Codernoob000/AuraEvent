{
  "name": "celebration-event-planner",
  "version": "1.0.0",
  "description": "AuraEvent — GenAI-Powered Celebration & Event Planner for Google Antigravity Prompt Wars",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node --check server.js services/geminiService.js",
    "dev": "node --watch server.js",
    "test": "node tests/code_quality_check.js && node tests/run_tests.js && node tests/regression.test.js && node tests/e2e.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "event-planner",
    "celebration",
    "google-gemini",
    "google-calendar",
    "security-first"
  ],
  "author": "Antigravity Builder",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "5.3.0",
    "express-rate-limit": "7.2.0",
    "helmet": "7.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
